default_platform :ios

$app_info_plist_path = "./TestApp/Resources/Info.plist"
$extension_info_plist_path = "./TestWidget/Info.plist"

platform :ios do

  desc "버전·빌드 번호 변경 (version:x.y.z build:n / 옵션 없으면 build +1)"
  lane :bump do |options|
    new_short_version = options[:version]
    new_build_number = options[:build]

    if new_build_number && new_build_number.to_i < 0
      UI.user_error!("빌드 넘버는 0 이상이어야 합니다. (입력값: #{new_build_number})")
    end

    info_plist_paths = [$app_info_plist_path, $extension_info_plist_path]
    new_version_number = nil

    info_plist_paths.each do |info_plist_path|
      current_version = get_info_plist_value(path: info_plist_path, key: "CFBundleShortVersionString")
      current_build_number = get_info_plist_value(path: info_plist_path, key: "CFBundleVersion").to_i

      if new_short_version
        set_info_plist_value(path: info_plist_path, key: "CFBundleShortVersionString", value: new_short_version)
        current_version = new_short_version
      end

      if new_build_number
        set_info_plist_value(path: info_plist_path, key: "CFBundleVersion", value: new_build_number.to_s)
        current_build_number = new_build_number.to_i
      elsif new_short_version.nil?
        current_build_number += 1
        set_info_plist_value(path: info_plist_path, key: "CFBundleVersion", value: current_build_number.to_s)
      end

      new_version_number = version_string(current_version, current_build_number)
      UI.message("New version in #{info_plist_path} -> #{new_version_number}")
    end

    git_commit(path: info_plist_paths, message: "Bump version to #{new_version_number}")
  end

  desc "Firebase 배포 (테스트: 시뮬레이터 빌드까지만, 업로드는 stub)"
  lane :firebase do
    prepare_build
    build_for_simulator
    UI.success("[stub] firebase_app_distribution → #{current_version_string}")
    UI.message(release_notes("테스트서버"))
  end

  desc "TestFlight 배포 (테스트: 시뮬레이터 빌드까지만, 업로드는 stub)"
  lane :test_flight do
    prepare_build
    build_for_simulator
    UI.success("[stub] pilot → #{current_version_string}")
  end
end

def prepare_build
  setup_ci if is_ci
  ensure_xcode_major("26")
end

def ensure_xcode_major(major)
  current = sh("xcodebuild -version", log: false)[/Xcode (\d+)/, 1]
  UI.user_error!("Xcode #{major}.x 가 필요합니다 (현재 #{current})") unless current == major
end

def build_for_simulator
  sh("cd .. && xcodebuild -workspace TestApp.xcworkspace -scheme TestApp " \
     "-destination 'generic/platform=iOS Simulator' -configuration Debug " \
     "CODE_SIGNING_ALLOWED=NO build | tail -20; exit ${PIPESTATUS[0]}")
end

def current_version_string
  build_number = get_info_plist_value(path: $app_info_plist_path, key: "CFBundleVersion").to_i
  version_number = get_info_plist_value(path: $app_info_plist_path, key: "CFBundleShortVersionString")
  version_string(version_number, build_number)
end

def release_notes(server_type)
  "서버: #{server_type}\n버전: #{current_version_string}"
end

def version_string(version_number, build_number)
  "iOS #{version_number} (#{build_number})"
end
